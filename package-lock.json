{
  "name": "machina-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "machina-workspace",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.19.0"
      }
    },
    "node_modules/@machina/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "packages/contracts": {
      "name": "@machina/contracts",
      "version": "0.1.0"
    }
  }
}
