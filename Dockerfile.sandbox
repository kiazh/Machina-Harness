# Sandbox execution image for terminal tool calls (terminal_sandbox=docker /
# execution mode sandbox). Built and tagged as machina-tool-sandbox:latest
# (see MACHINA_TERMINAL_IMAGE / OPERATIONS.md):
#
#   docker build -f Dockerfile.sandbox -t machina-tool-sandbox:latest .
#
# INFRA-B1 (infra audit): this file previously copied a stale `ah/` path from
# before the package rename, so the image could not build at all and CI never
# noticed. The context now matches pyproject's forced includes (machina +
# skills). Runtime-only install: dev extras have no place in an isolation
# image whose root filesystem is mounted read-only at run time.
#
# Base image pinned by tag@digest (R4-095); Dependabot's docker ecosystem
# bumps it. Do not replace with a moving tag.
FROM python:3.13-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

WORKDIR /build
COPY pyproject.toml uv.lock README.md ./
COPY machina ./machina
COPY skills ./skills

# F-15: install the exact uv.lock resolution; F-14: remove the build tree from
# the isolation image (only site-packages and the console script are needed).
# uv itself is removed so the sandbox carries no resolver/build tooling.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git findutils grep coreutils diffutils \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "uv==0.11.7" \
    && uv export --frozen --no-dev --no-hashes --no-emit-project -o /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && pip install --no-cache-dir --no-deps . \
    && pip uninstall -y uv \
    && rm -rf /build /tmp/requirements.txt /root/.cache \
    && mkdir -p /workspace && chown 65534:65534 /workspace

USER 65534:65534
WORKDIR /workspace
