tests/
ui/
packages/
internal/
integrations/
communications/
.agents/
.github/

# Exclude local state, credentials and dependency caches from build context
.venv.*/
.env.*
!.env.example
**/*.bak
**/*.bak-*
**/*.orig
**/*.rej
ui/node_modules/
.ruff_cache/
.skill-hub/
coverage.xml
# N5 (final pass): runtime skill telemetry is machine-local state; keep it out
# of image build contexts (hatch force-include cannot exclude it from wheels).
skills/telemetry.json
skills/telemetry.json.lock
